{
  "domain": "ranobes.net",
  "titleSelector": "h1.title, meta[property='og:title']",
  "authorSelector": ".subtitle",
  "coverImageSelector": ".poster img, meta[property='og:image']",
  "summarySelector": ".r-desription .cont-text, meta[property='og:description']",
  "tagSelector": "meta[property='og:news_keywords']",
  "chapterLinkSelector": ".chapters-scroll-list li a, a.chapter-item",
  "chapterContentSelector": "#arrticle, .text#arrticle",
  "chapterDateSelector": ".r-date time",
  "ratingSelector": null,
  "chapterUrlRegex": "https?://(?:www\\.)?ranobes\\.net/([^/]+)-(\\d+)/\\d+\\.html",
  "novelUrlTemplate": "https://ranobes.net/novels/{2}-{1}.html",
  "requiresWebView": false,
  "isCustom": false,
  "initials": "RN",
  "watermarkPhrases": []
}
