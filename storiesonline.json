{
  "domain": "storiesonline.net",
  "titleSelector": "h1, h2:not(.date):not(#theend)",
  "authorSelector": "a[rel='author'], a[href*='/a/'], .vh h2",
  "coverImageSelector": "img#itsCover, .c img[src*='/i/']",
  "summarySelector": "#s-details, .story-desc, .description",
  "tagSelector": "#s-details a[href*='genre'], #s-details a[href*='tag'], .tags a",
  "chapterLinkSelector": "#index-list a, .link a",
  "chapterContentSelector": "article, #story, .chapter-content",
  "chapterDateSelector": ".date",
  "ratingSelector": "#score, meta[name='rating']",
  "chapterUrlRegex": "https?://(?:www\\.)?storiesonline\\.net/n/(\\d+)/([^/]+)/(\\d+)",
  "novelUrlTemplate": "https://storiesonline.net/n/{1}/{2}",
  "requiresWebView": false,
  "isCustom": false,
  "initials": "SO",
  "supportsNewChapters": false,
  "rateLimitMs": 4500,
  "loginUrlTemplate": "https://storiesonline.net/sol-secure/login.php?rp={path}",
  "noiseSelectors": [
    "#vote-form",
    ".vform",
    "#foDiv",
    "#voteStatusDiv",
    "#score",
    "select#score",
    ".sol-rating",
    "h3.end",
    "#theend",
    "#voForm",
    "#bott-header",
    "#dhold",
    "div.bread",
    "#top-header",
    ".end",
    "#mffospan",
    "#cAuth",
    "a[href*='contact_webmaster']",
    "a[href*='comments.php']",
    "a[href*='sol-secure']"
  ],
  "dynamicDetails": {
    "triggerSelector": "#s-details",
    "endpointTemplate": "https://storiesonline.net/res/responders/moreData.php",
    "method": "POST",
    "jsVariables": [
      "story_id",
      "ucc",
      "ci",
      "ccc",
      "tto"
    ],
    "formDataTemplate": {
      "fn": "showDetails",
      "a[]": "{story_id}",
      "ucc": "{ucc}",
      "ci": "{ci}",
      "ccc": "{ccc}",
      "tto": "{tto}"
    },
    "injectTargetSelector": "#s-details"
  }
}